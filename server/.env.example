# Copy to .env (never commit .env). Defaults suit local development.
# Postgres (Docker Compose uses this form). Omit for a local SQLite dev database.
DATABASE_URL=postgresql://collab:collab@localhost:5432/collab
# Leave empty to run one process without Redis fan-out.
REDIS_URL=redis://localhost:6379/0
MAX_MESSAGE_BYTES=262144
MAX_OPS_PER_BATCH=500
RATE_LIMIT_OPS_PER_SEC=200
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
